# 应用
APP_NAME=AegisCode
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 日志
LOG_LEVEL=INFO

# 新入口配置：默认 SQLite；企业使用 postgresql+asyncpg://...
AEGIS_DATA_DIR=data
AEGIS_DATABASE_URL=
AEGIS_REGISTRATION_ENABLED=true
AEGIS_MAX_CONCURRENT_RUNS=4
AEGIS_MAX_CHILD_RUNS=2
AEGIS_MAX_MODEL_CALLS=6
AEGIS_MAX_USER_RUNS=4
AEGIS_MAX_STEPS=10
AEGIS_RUN_TIMEOUT_SECONDS=300
AEGIS_MODEL_TIMEOUT_SECONDS=45
AEGIS_EVOLUTION_ENABLED=true
AEGIS_EVOLUTION_TIMEOUT_SECONDS=30

# 多模型：密钥仅放在 api_key_env 指定的环境变量，禁止写进 JSON。
# AEGIS_MODELS_JSON='[{"model":"your-model","base_url":"https://your-endpoint/v1","api_key_env":"PRIMARY_MODEL_KEY","priority":0},{"model":"backup-model","base_url":"https://backup-endpoint/v1","api_key_env":"BACKUP_MODEL_KEY","priority":1}]'
AEGIS_MODELS_JSON=[]

# 外部 MCP 仅接受运维预配置的服务与工具名，所有调用均须审批。
# MCP必须绑定tenant_ids或user_ids；二者同时配置时均须匹配，默认不授权。
# AEGIS_MCP_SERVERS_JSON='[{"name":"enterprise","url":"https://your-mcp/mcp","tools":["search"],"token_env":"ENTERPRISE_MCP_TOKEN","tenant_ids":["请填登录后返回的tenant_id"]}]'
AEGIS_MCP_SERVERS_JSON=[]
AEGIS_SANDBOX_URL=
AEGIS_SANDBOX_TOKEN=
AEGIS_REPOSITORY_ROOT=

# 默认分块 BM25；hybrid 需安装 rag 依赖并配置以下参数。
AEGIS_KNOWLEDGE_BACKEND=bm25
AEGIS_KNOWLEDGE_EMBEDDING_MODEL=
AEGIS_KNOWLEDGE_MILVUS_HOST=
AEGIS_KNOWLEDGE_MILVUS_PORT=19530
AEGIS_KNOWLEDGE_MILVUS_USER=
AEGIS_KNOWLEDGE_MILVUS_PASSWORD=
AEGIS_KNOWLEDGE_RERANK_MODEL=

# Docker 企业版必须自行设置；不提供可直接用于生产的默认密码。
POSTGRES_PASSWORD=
